# Server Configuration
PORT=3001
DATA_DIR=./data
# Your time zone (used by Docker; a normal install uses the computer's own time zone)
# TZ=America/Chicago

# Optional: Google OAuth2 Credentials (for Multi-Account Google Calendar & Google Photos Picker)
# Can also be entered directly in Lucarne Settings UI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Optional: Gemini API Key (for Clean Recipe Web Extraction & Meal Search)
# Can also be entered directly in Lucarne Settings UI
GEMINI_API_KEY=
# Optional: pin a Gemini model (default: newest stable gemini-*-flash, chosen automatically)
# GEMINI_MODEL=
# Optional: set to 1 if your Gemini key has billing enabled (turns off Lucarne's free-tier request limits)
# GEMINI_PAID_TIER=1

# Optional: Python used to create the Google Keep helper's environment (npm run keep:setup)
# KEEP_PYTHON=python3
